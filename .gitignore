# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude plan files
*.tfplan
*.plan

# Ignore variable files containing secrets
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore Terraform lock file (optional)
# Uncomment if you don't want to version it
# .terraform.lock.hcl

# VS Code
.vscode/

# IntelliJ
.idea/

# macOS
.DS_Store

